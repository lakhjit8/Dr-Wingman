# Copy to tests/.env.test (gitignored) for local test runs.
# In CI, set these as repository secrets instead — see .github/workflows/test.yml.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_REF=your-project-ref
# Personal access token from supabase.com > Account > Access Tokens — used
# only by the test suite to query the DB/logs directly via the Management
# API, never by the app itself.
SUPABASE_ACCESS_TOKEN=sbp_your-access-token

# Must match the Edge Function secret of the same name (supabase secrets set
# TEST_MODE_SECRET=...) — lets tests/persistence.test.ts and tests/logs.test.ts
# force a simulated Claude API failure without spending a real API call.
TEST_MODE_SECRET=some-long-random-string
